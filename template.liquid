<!-- Paste into the Private Plugin "Markup" editor on trmnl.com.
     TRMNL X renders at a ~936x702 logical viewport (2x pixel density).
     Layout: provider gauge groups + $/day chart + top-project bars.
     Tiles at >=90% invert to black. No title bar; "updated" sits bottom-right. -->

<div style="height: 100%; display: flex; flex-direction: column; font-family: 'Helvetica Neue', Arial, sans-serif; padding: 26px 28px 14px 28px; box-sizing: border-box;">

  <!-- gauge groups: provider named once, tiles share the row -->
  <div style="display: flex; gap: 30px;">
    {% for group in gauge_groups %}
    <div style="flex: {{ group.tiles | size }}; min-width: 0;">
      <div style="font-size: 16px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{ group.who }}</div>
      <div style="display: flex; gap: 18px;">
        {% for g in group.tiles %}
          {% if g.pct >= 90 %}
            {% assign tile_bg = "background: #000; color: #fff;" %}
            {% assign bar_edge = "#fff" %}
            {% assign bar_fill = "#fff" %}
            {% assign reset_color = "#bbb" %}
          {% else %}
            {% assign tile_bg = "" %}
            {% assign bar_edge = "#000" %}
            {% assign bar_fill = "#000" %}
            {% assign reset_color = "#555" %}
          {% endif %}
          <div style="flex: 1; border: 3px solid #000; padding: 15px 17px 16px; {{ tile_bg }}">
            <div style="font-size: 18px; font-weight: bold; margin-bottom: 12px;">{{ g.win }}</div>
            <div style="font-size: 56px; font-weight: bold; line-height: 1; margin-bottom: 14px;">{{ g.pct }}%</div>
            <div style="border: 2px solid {{ bar_edge }}; height: 20px; margin-bottom: 9px;">
              <div style="background: {{ bar_fill }}; height: 100%; width: {{ g.pct }}%;"></div>
            </div>
            <div style="font-size: 13px; color: {{ reset_color }}; white-space: nowrap; overflow: hidden;">resets {{ g.reset }}</div>
          </div>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>

  <!-- bottom band fills the rest -->
  <div style="display: flex; gap: 38px; margin-top: 26px; flex: 1; min-height: 0;">

    <!-- $ per day (stacked: black = Claude Code, gray = other agents) -->
    <div style="flex: 1; min-width: 0; display: flex; flex-direction: column;">
      {% if costs_ok %}
        <div style="display: flex; justify-content: space-between; align-items: baseline; border-bottom: 3px solid #000; padding-bottom: 7px; margin-bottom: 14px;">
          <span style="font-size: 18px; font-weight: bold;">API-equivalent $</span>
          <span style="font-size: 18px;">${{ cost_week }} · 7d</span>
        </div>
        <div style="display: flex; align-items: flex-end; gap: 13px; flex: 1;">
          {% for day in cost_days %}
          <div style="flex: 1; display: flex; flex-direction: column; justify-content: flex-end; height: 100%; text-align: center;">
            <div style="font-size: 14px; margin-bottom: 4px;">${{ day.c }}</div>
            <!-- reversed: first segment (Claude) ends up at the bottom of the stack -->
            {% for seg in day.seg reversed %}
            <div style="background: {{ seg.s }}; width: 100%; height: {{ seg.h }}px;"></div>
            {% endfor %}
          </div>
          {% endfor %}
        </div>
        <div style="display: flex; gap: 13px; margin-top: 6px;">
          {% for day in cost_days %}
          <div style="flex: 1; font-size: 14px; text-align: center; color: #555;">{{ day.d }}</div>
          {% endfor %}
        </div>
        <div style="font-size: 13px; color: #555; margin-top: 10px;">
          {% for item in cost_legend %}
          <span style="display: inline-block; width: 12px; height: 12px; background: {{ item.s }};"></span> {{ item.label }}{% unless forloop.last %}&nbsp;&nbsp;{% endunless %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- top projects with bars -->
    <div style="flex: 1; min-width: 0; display: flex; flex-direction: column;">
      {% if projects_ok %}
        <div style="display: flex; justify-content: space-between; align-items: baseline; border-bottom: 3px solid #000; padding-bottom: 7px; margin-bottom: 8px;">
          <span style="font-size: 18px; font-weight: bold;">Top projects · 7d</span>
          <span style="font-size: 14px; color: #555;">Claude Code + Codex</span>
        </div>
        <div style="flex: 1; display: flex; flex-direction: column; justify-content: space-around;">
          {% for project in top_projects %}
          <div>
            <div style="display: flex; justify-content: space-between; align-items: baseline; font-size: 19px; margin-bottom: 5px;">
              <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding-right: 10px;">{{ project.name }}</span>
              <span style="font-weight: bold;">${{ project.c }}</span>
            </div>
            <!-- 7-day sparkline, same day columns as the chart on the left -->
            <div style="display: flex; align-items: flex-end; gap: 5px; height: 26px; border-bottom: 1px solid #999;">
              {% for h in project.s %}
              <div style="flex: 1; background: #000; height: {{ h | times: 26 | divided_by: 100 }}px;"></div>
              {% endfor %}
            </div>
          </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

  </div>

  {% if errors != empty %}
  <div style="background: #000; color: #fff; font-size: 15px; font-weight: bold; padding: 8px 14px; margin-top: 10px;">
    &#9888; {{ errors | join: " &nbsp;·&nbsp; " }}
  </div>
  {% endif %}

  <div style="text-align: right; font-size: 13px; color: #555; margin-top: 10px;">updated {{ updated_at }}</div>

</div>
