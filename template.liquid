<!-- Paste into the Private Plugin "Markup" editor on trmnl.com.
     Sized explicitly for TRMNL X (1872x1404, 16-grayscale). -->

<div style="height: 100%; display: flex; flex-direction: column; justify-content: space-between;">

  <!-- Row 1: rate limits -->
  <div style="display: flex; gap: 100px; padding: 50px 70px 0 70px;">

    <!-- Claude Code -->
    <div style="flex: 1;">
      <div style="font-size: 58px; font-weight: bold; margin-bottom: 36px;">Claude Code{% if claude_plan %} · {{ claude_plan }}{% endif %}</div>
      {% if claude_ok %}
        <div style="margin-bottom: 40px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; font-size: 38px; margin-bottom: 12px;">
            <span>Session (5h)</span>
            <span style="font-size: 50px; font-weight: bold;">{{ claude_session_pct }}%</span>
          </div>
          <div style="border: 4px solid black; height: 48px;">
            <div style="background: black; height: 100%; width: {{ claude_session_pct }}%;"></div>
          </div>
          <div style="font-size: 30px; margin-top: 8px; color: #555;">resets {{ claude_session_reset }}</div>
        </div>
        <div style="margin-bottom: 40px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; font-size: 38px; margin-bottom: 12px;">
            <span>Weekly</span>
            <span style="font-size: 50px; font-weight: bold;">{{ claude_weekly_pct }}%</span>
          </div>
          <div style="border: 4px solid black; height: 48px;">
            <div style="background: black; height: 100%; width: {{ claude_weekly_pct }}%;"></div>
          </div>
          <div style="font-size: 30px; margin-top: 8px; color: #555;">resets {{ claude_weekly_reset }}</div>
        </div>
        {% for scoped in claude_scoped %}
        <div style="margin-bottom: 40px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; font-size: 38px; margin-bottom: 12px;">
            <span>Weekly · {{ scoped.name }}</span>
            <span style="font-size: 50px; font-weight: bold;">{{ scoped.pct }}%</span>
          </div>
          <div style="border: 4px solid black; height: 48px;">
            <div style="background: black; height: 100%; width: {{ scoped.pct }}%;"></div>
          </div>
          <div style="font-size: 30px; margin-top: 8px; color: #555;">resets {{ scoped.reset }}</div>
        </div>
        {% endfor %}
      {% else %}
        <div style="font-size: 38px; color: #555;">no data</div>
      {% endif %}
    </div>

    <!-- Codex -->
    <div style="flex: 1;">
      <div style="font-size: 58px; font-weight: bold; margin-bottom: 36px;">Codex{% if codex_plan %} · {{ codex_plan }}{% endif %}</div>
      {% if codex_ok %}
        <div style="margin-bottom: 40px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; font-size: 38px; margin-bottom: 12px;">
            <span>{{ codex_primary_label | capitalize }}</span>
            <span style="font-size: 50px; font-weight: bold;">{{ codex_primary_pct }}%</span>
          </div>
          <div style="border: 4px solid black; height: 48px;">
            <div style="background: black; height: 100%; width: {{ codex_primary_pct }}%;"></div>
          </div>
          <div style="font-size: 30px; margin-top: 8px; color: #555;">resets {{ codex_primary_reset }}</div>
        </div>
        {% if codex_secondary_pct %}
        <div style="margin-bottom: 40px;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; font-size: 38px; margin-bottom: 12px;">
            <span>{{ codex_secondary_label | capitalize }}</span>
            <span style="font-size: 50px; font-weight: bold;">{{ codex_secondary_pct }}%</span>
          </div>
          <div style="border: 4px solid black; height: 48px;">
            <div style="background: black; height: 100%; width: {{ codex_secondary_pct }}%;"></div>
          </div>
          <div style="font-size: 30px; margin-top: 8px; color: #555;">resets {{ codex_secondary_reset }}</div>
        </div>
        {% endif %}
      {% else %}
        <div style="font-size: 38px; color: #555;">no data</div>
      {% endif %}
    </div>

  </div>

  <!-- Row 2: cost chart + top projects -->
  <div style="display: flex; gap: 100px; padding: 30px 70px 0 70px;">

    <!-- $ per day -->
    <div style="flex: 1;">
      {% if costs_ok %}
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 20px;">
          <span style="font-size: 42px; font-weight: bold;">API-equivalent $ / day</span>
          <span style="font-size: 42px;">${{ cost_week }} / 7d</span>
        </div>
        <div style="display: flex; align-items: flex-end; gap: 24px; height: 220px;">
          {% for day in cost_days %}
          <div style="flex: 1; display: flex; flex-direction: column; justify-content: flex-end; height: 100%;">
            <div style="font-size: 26px; text-align: center; margin-bottom: 4px;">${{ day.c }}</div>
            <div style="background: black; width: 100%; height: {{ day.h | times: 1.6 }}px;"></div>
          </div>
          {% endfor %}
        </div>
        <div style="display: flex; gap: 24px; margin-top: 8px;">
          {% for day in cost_days %}
          <div style="flex: 1; font-size: 28px; text-align: center; color: #555;">{{ day.d }}</div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Top projects -->
    <div style="flex: 1;">
      {% if projects_ok %}
        <div style="font-size: 42px; font-weight: bold; margin-bottom: 20px;">Top projects (7d)</div>
        {% for project in top_projects %}
        <div style="display: flex; justify-content: space-between; align-items: baseline; font-size: 36px; padding: 12px 0; border-bottom: 2px solid #999;">
          <span>{{ forloop.index }}. {{ project.name }}</span>
          <span style="font-weight: bold;">${{ project.c }}</span>
        </div>
        {% endfor %}
      {% endif %}
    </div>

  </div>

  <div class="title_bar">
    <span class="title">AI Usage</span>
    <span class="instance">updated {{ updated_at }}</span>
  </div>

</div>
